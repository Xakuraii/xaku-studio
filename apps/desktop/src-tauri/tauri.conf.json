{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XakuStudio",
  "version": "0.1.0",
  "identifier": "com.xakustudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XakuStudio",
        "width": 1360,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
